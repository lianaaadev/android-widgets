<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      One permission per thing we actually display, requested only when a widget asks for it.
      An app called "Health" that asked for the union of everything behind Health Connect would
      look like spyware, and would deserve to.
    -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!--
      A separate grant, and one that lives in the system module: unavailable on Android 13 and
      below even with the Health Connect APK installed. Check at runtime with
      HealthConnectFeatures.FEATURE_READ_HEALTH_DATA_IN_BACKGROUND before relying on it — without
      it the widget only refreshes while the app is open, which the app has to say plainly rather
      than appear broken.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!--
      Deliberately NOT requested: android.permission.health.READ_HEALTH_DATA_HISTORY. Without it
      we see the last 30 days, which comfortably contains both the current weight and the 7-day
      comparison the trend needs. Asking for someone's entire weight history to show today's
      figure is not a trade worth making.
    -->

    <!--
      Package visibility. Without this, Android 11+ hides the Health Connect package from us and
      getSdkStatus() reports it missing on a phone that has it installed.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".HealthApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Health">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android 13 and below: Health Connect shows this app's rationale by launching the
              declaring activity with this action. Health Connect will not grant permissions to
              an app that does not handle it, so this is not optional decoration.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Shown by the launcher when a widget is placed, and again to recolour one. -->
        <activity
            android:name=".widget.HealthWidgetConfigActivity"
            android:exported="true"
            android:label="@string/configure_widget"
            android:theme="@style/Theme.Health">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.WeightWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_widget_info" />
        </receiver>

        <!--
          Samsung Flex Window (Galaxy Z Flip cover screen).

          The cover screen does not surface arbitrary widgets: an app has to opt in with the
          second, Samsung-specific meta-data below. Documented at
          https://developer.samsung.com/galaxy-z/flex_window.html

          That documentation is Flip 5 / One UI 5.1.1 era, and there is no cover screen in the
          emulator, so this declaration can only be verified on the device itself.
        -->
        <receiver
            android:name=".widget.WeightCoverWidgetReceiver"
            android:exported="true"
            android:label="@string/cover_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_cover_widget_info" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_health_widget_info" />
        </receiver>

        <activity
            android:name=".ui.PrivacyActivity"
            android:exported="false"
            android:label="@string/privacy_title" />

        <!--
          Android 14+ replaced the rationale action above with a permission-usage intent, and
          wants it on its own component rather than sharing the launcher activity's filter.
          Same destination, different door.
        -->
        <activity-alias
            android:name=".ui.PermissionsRationaleAlias"
            android:exported="true"
            android:targetActivity=".ui.PrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>


        <!--
          Everything that can invalidate a rendered recency line. ACTION_DATE_CHANGED is
          deliberately absent: it is not reliably delivered to manifest-registered receivers
          from Android 8, so the daily alarm carries the rollover instead.
        -->
        <receiver
            android:name=".work.DailyTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.liana.health.action.TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
